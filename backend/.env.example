PORT=8080
NODE_ENV=development
# Public base URL devices use to reach the API (returned in enrollment responses)
PUBLIC_API_URL=http://localhost:8080
# Host header of the shared platform API (custom tenant domains are also accepted)
PLATFORM_API_HOST=localhost:8080

# Runtime role — subject to Row-Level Security
DATABASE_URL=postgres://app_runtime:app_runtime@localhost:5432/device_platform
# Owner role — used only by migrations (needs BYPASSRLS or superuser)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/device_platform

REDIS_URL=redis://localhost:6379
MQTT_URL=mqtt://localhost:1883

# JWT signing secrets (use long random values in production)
JWT_SECRET=change-me-platform-jwt-secret
PROVISIONING_JWT_SECRET=change-me-provisioning-secret
DEVICE_JWT_TTL=30d
ADMIN_JWT_TTL=12h

# Super-admin API key for /api/v1/platform/* (tenant provisioning, suspension)
PLATFORM_ADMIN_KEY=change-me-platform-admin-key

# Firebase Admin — leave empty to log FCM pushes instead of sending them
GOOGLE_APPLICATION_CREDENTIALS=

# Signature checksum of the DPC APK (base64url SHA-256 of the signing cert) placed in QR / ZTE payloads
DPC_PACKAGE_NAME=com.inditech.dpc
DPC_ADMIN_COMPONENT=com.inditech.dpc/.admin.EnterpriseAdminReceiver
DPC_SIGNATURE_CHECKSUM=
DPC_DOWNLOAD_URL=https://downloads.example.com/dpc/app-release.apk

# Background worker cadence
OVERDUE_EVALUATOR_CRON=*/10 * * * *
HEARTBEAT_RECONCILIATION_CRON=*/15 * * * *
